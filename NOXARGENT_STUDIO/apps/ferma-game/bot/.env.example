# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token
# Публичный HTTPS-адрес игры (домен на VPS). Telegram открывает WebApp только по https://
WEBAPP_URL=https://1-2-3-4.sslip.io
# Где слушает веб-сервер (nginx проксирует сюда)
HOST=127.0.0.1
PORT=8080
# База SQLite
DB_PATH=data/ferma.sqlite3
# Папка с фронтендом
WEBAPP_DIR=../webapp
# Сколько часов действует подпись initData (защита от повторного использования)
INIT_DATA_TTL_HOURS=24
# Рейтинг по временному id (игроки вне Telegram). Когда бот запущен — поставьте 0, чтобы в рейтинге были только игроки из Telegram
ALLOW_ANON=1
# На боевом сервере: ALLOW_ANON=0 и DEV_MODE=0 (только игроки из Telegram)
DEV_MODE=0
# Ваш Telegram id (узнать: @userinfobot) — бот пишет сюда итоги недели и если не хватило звёзд на подарок
ADMIN_ID=0
# Канал сериала — кнопка в /start и /paysupport
CHANNEL_URL=https://t.me/predstav_kanal
# 1 — все покупки по 1 ⭐ (проверка оплаты перед запуском). Потом поставить 0 и перезапустить
TEST_PRICES=0
# Обязательная подписка на канал (бот должен быть администратором канала). 0 — выключить
# 1 — обязательная подписка на канал и чат (сейчас выключена)
REQUIRE_SUB=0
CHANNEL_ID=@predstav_kanal
# Чат фермеров — тоже обязательно вступить (бот — админ чата). Пусто — только канал
CHAT_ID=@predstav_chat
CHAT_URL=https://t.me/predstav_chat
