# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token
# Публичный HTTPS-адрес игры (домен на VPS). Telegram открывает WebApp только по https://
WEBAPP_URL=https://ferma.example.ru
# Где слушает веб-сервер (nginx проксирует сюда)
HOST=127.0.0.1
PORT=8080
# База SQLite
DB_PATH=data/ferma.sqlite3
# Папка с фронтендом
WEBAPP_DIR=../webapp
# Сколько часов действует подпись initData (защита от повторного использования)
INIT_DATA_TTL_HOURS=24
